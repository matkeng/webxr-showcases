{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drawing Workbench",
  "version": "0.1.0",
  "identifier": "com.drawingworkbench.poc",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drawing Workbench",
        "width": 1000,
        "height": 760,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/workbench-engine"],
    "shortDescription": "Drawing Workbench proof of concept",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
